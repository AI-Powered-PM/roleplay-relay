{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "Settings window: settings and API-key commands only (plus event listen, for the close request). Folder opening is done by the Rust command open_data_folder (fixed sub-folders), so no opener or fs permission is granted to the WebView.",
  "windows": ["settings"],
  "permissions": [
    "allow-has-api-key",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-get-settings",
    "allow-save-settings",
    "allow-open-data-folder",
    "allow-get-hotkey-status",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-list-languages",
    "allow-get-prompt-language-notes",
    "allow-test-api-key",
    "allow-get-game-profile",
    "allow-get-last-mode",
    "allow-preview-overlay",
    "allow-close-settings",
    "core:event:allow-listen"
  ]
}
